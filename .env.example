# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost
TIMEZONE=Asia/Kolkata

# PostgreSQL Database
DATABASE_URL=postgresql://gym_user:gym_password@localhost:5432/gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
POSTGRES_DB=gym_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=gym_minio_admin
MINIO_SECRET_KEY=gym_minio_secret
MINIO_BUCKET_UPLOADS=gym-uploads
MINIO_BUCKET_REPORTS=gym-reports
MINIO_BUCKET_ARCHIVE=gym-archive

# Authentication & Sessions
SESSION_SECRET=dev_session_secret_replace_in_production_32chars
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# PayU Payment Gateway (Day Scholar gym passes)
# placeholder_* keys → simulated checkout (no PayU redirect). Set real key/salt for live payments.
PAYU_MERCHANT_KEY=placeholder_payu_key
PAYU_MERCHANT_SALT=placeholder_payu_salt
PAYU_VERIFICATION_SALT=
PAYU_ENV=TEST
PAYU_BASE_URL=https://test.payu.in/_payment
# Public API origin PayU calls for surl/furl/webhook (no trailing slash)
PAYU_BACKEND_URL=http://localhost:4000
# Where browsers land after PayU (?payment=success|pending|cancelled)
FRONTEND_URL=http://localhost:5173

# Access Control WebSocket
ACCESS_WS_PORT=4001
ACCESS_DEVICE_TOKEN=dev_access_device_token_secret

# Python FastAPI bridge (gym_api_app) → ZKBio device portal
# Local dev: http://localhost:44444 (or :8000). Remote tunnel: your ngrok URL.
API_APP_URL=http://localhost:44444

# 4-way ZKBio department routing — must match the ZKBio admin panel dept codes.
# Discover them via GET {API_APP_URL}/api/zkbio/departments, then restart backend.
ZKBIO_DEPT_DAY_SCHOLAR_BOYS=1
ZKBIO_DEPT_DAY_SCHOLAR_GIRLS=4
ZKBIO_DEPT_HOSTELLER_BOYS=3
ZKBIO_DEPT_HOSTELLER_GIRLS=2

# face_ML service (face_ML/start_service.bat). Token = face_ML/data/admin.token
FACE_ML_URL=http://127.0.0.1:8001
FACE_ML_TOKEN=

# false = testing: do not talk to the Gym API / ZKBio portal (faces stay in the gym app only)
ZKBIO_SYNC_ENABLED=true
